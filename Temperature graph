// Write a program to show the temperature and shows a graph of the recent measurements.

// Define the analog pin where the LM35 is connected

int lm35Pin = A0; //Analog pin A0

float temperature; //Variable to store temperature value

void setup() {

//Start serial communication for displaying data

Serial.begin(9600);

}

void loop() {

//Read the analog value from the LM35

int sensorValue = analogRead(lm35Pin);

//Convert the analog reading to a voltage (0-5V range)

float voltage = sensorValue * (5.0 / 1023.0);

//Convert the voltage to temperature (LM35 provides 10mV per degree Celsius)

temperature = voltage * 100.0;

//Send the temperature value to the serial monitor

Serial.println(temperature);

//Wait for 1 second before repeating the loop

delay(1000);

}
